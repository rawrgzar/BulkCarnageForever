<Window x:Class="BulkCarnageForever.V10.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="BulkCarnageForever · Food Library"
        Width="1390" Height="870" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0D121B" Foreground="#EFF5FA"
        FontFamily="Segoe UI" Loaded="Window_Loaded"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#172231"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#202F40"/>
        <SolidColorBrush x:Key="Line" Color="#334253"/>
        <SolidColorBrush x:Key="Accent" Color="#BDF473"/>
        <SolidColorBrush x:Key="Muted" Color="#94A6BA"/>

        <Style x:Key="CaptionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>

        <Style x:Key="CatalogCardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="7"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="#1B2838"
                                BorderBrush="#304255" BorderThickness="1"
                                CornerRadius="14" Padding="17">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26384A"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#739D65"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26392F"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#BDF473"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left navigation and catalog filters -->
        <Border Grid.Column="0" Background="#111A26" BorderBrush="#283849"
                BorderThickness="0,0,1,0">
            <Grid Margin="22,27,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="3,0,0,40">
                    <Border Width="44" Height="44" CornerRadius="13"
                            Background="#30472C" HorizontalAlignment="Left"
                            Margin="0,0,0,15">
                        <TextBlock Text="B" FontSize="25" FontWeight="Bold"
                                   Foreground="#BDF473" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="BULK CARNAGE" FontSize="19" FontWeight="Bold"
                               Foreground="#F6FAFF"/>
                    <TextBlock Text="FOREVER  /  V10" FontSize="12" FontWeight="SemiBold"
                               Foreground="#BDF473" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" Style="{StaticResource CaptionLabel}"
                               Margin="1,0,0,12"/>
                    <Border Background="#273C30" BorderBrush="#486647"
                            BorderThickness="1" CornerRadius="9"
                            Padding="12" Margin="0,0,0,8">
                        <TextBlock Text="▦   Food Library" Foreground="#D9F8B9"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                    <ui:Button Content="◷   Daily Nutrition" Appearance="Secondary"
                               Height="43" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left"
                               Click="OpenMeals_Click" Margin="0,0,0,32"/>

                    <TextBlock Text="FILTER YOUR FOODS" Style="{StaticResource CaptionLabel}"
                               Margin="1,0,0,17"/>
                    <TextBlock Text="Category" Style="{StaticResource CaptionLabel}"/>
                    <ComboBox x:Name="CategoryComboBox" Height="42"
                                 HorizontalAlignment="Stretch" FontSize="13"
                                 SelectionChanged="CategoryComboBox_SelectionChanged"/>
                    <TextBlock Text="Brand" Style="{StaticResource CaptionLabel}"
                               Margin="0,22,0,9"/>
                    <ComboBox x:Name="BrandComboBox" Height="42"
                                 HorizontalAlignment="Stretch" FontSize="13"
                                 SelectionChanged="BrandComboBox_SelectionChanged"/>

                    <Border BorderBrush="#2D3D4F" BorderThickness="0,1,0,0"
                            Margin="0,32,0,20"/>
                    <TextBlock Text="LOCAL DATABASE" Style="{StaticResource CaptionLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="2,5,0,0">
                        <Ellipse Width="9" Height="9" Fill="#BDF473"
                                 VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="SQLite · Offline" Foreground="#D7E3EE"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="2" Background="#192736" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="NO CLOUD. NO BS." Foreground="#BDF473"
                                   FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="Your nutrition. Your machine."
                                   Foreground="#94A6BA" FontSize="11" Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="FOOD EXPLORER" FontSize="11" FontWeight="Bold"
                               Foreground="#BDF473" Margin="1,0,0,8"/>
                    <TextBlock Text="Find your fuel." FontSize="34" FontWeight="Bold"
                               Foreground="#F5F8FC"/>
                    <TextBlock Text="Explore foods, compare macros, and build your day."
                               FontSize="14" Foreground="#98A9BD" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#243B2D" CornerRadius="18"
                        VerticalAlignment="Center" Padding="14,9">
                    <TextBlock Text="●  OFFLINE FIRST" FontWeight="SemiBold"
                               Foreground="#BDF473" FontSize="11"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="#1A2737" BorderBrush="#304255"
                    BorderThickness="1" CornerRadius="13" Padding="17,15"
                    Margin="0,0,0,23">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Nutrition catalog" Foreground="#F3F7FC"
                                   FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Search a food name, or narrow by category and brand."
                                   Foreground="#94A6BA" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="100% LOCAL" Foreground="#BDF473"
                               FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchTextBox" Grid.Row="0" Height="46"
                            ToolTip="Search food names"
                            FontSize="14"
                            TextChanged="SearchTextBox_TextChanged"/>
                <Grid Grid.Row="1" Margin="1,21,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Food library" Foreground="#F3F7FC"
                                   FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="  /  browse" Foreground="#8195AC"
                                   FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="8" Background="#263C30"
                            Padding="12,7">
                        <TextBlock x:Name="CountLabel" Foreground="#BDF473"
                                   FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="3" Background="#101924" BorderBrush="#263749"
                    BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                <ListBox x:Name="FoodGrid" Background="Transparent"
                         BorderThickness="0" Padding="11"
                         ItemContainerStyle="{StaticResource CatalogCardItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="302" ItemHeight="212"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="49"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding GroupName}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#BDF473" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Text="{Binding RecipeName}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#F4F8FC" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="43"/>
                                <TextBlock Grid.Row="2" Text="{Binding BrandType}"
                                           FontSize="12" Foreground="#99ABC0"
                                           TextTrimming="CharacterEllipsis"/>
                                <Grid Grid.Row="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#344659"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CAL"
                                               Foreground="#8FA2B8" FontSize="10" TextAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="PROTEIN"
                                               Foreground="#8FA2B8" FontSize="10" TextAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="CARBS"
                                               Foreground="#8FA2B8" FontSize="10" TextAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="FATS"
                                               Foreground="#8FA2B8" FontSize="10" TextAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Text="{Binding CaloriesPerServing, StringFormat={}{0:0.#}}"
                                               Foreground="#BDF473" FontSize="16" FontWeight="Bold"
                                               TextAlignment="Center" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{Binding Protein, StringFormat={}{0:0.#}g}"
                                               Foreground="#F2F7FC" FontSize="15" FontWeight="SemiBold"
                                               TextAlignment="Center" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2"
                                               Text="{Binding Carbs, StringFormat={}{0:0.#}g}"
                                               Foreground="#F2F7FC" FontSize="15" FontWeight="SemiBold"
                                               TextAlignment="Center" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3"
                                               Text="{Binding Fats, StringFormat={}{0:0.#}g}"
                                               Foreground="#F2F7FC" FontSize="15" FontWeight="SemiBold"
                                               TextAlignment="Center" Margin="0,5,0,0"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Existing page-based navigation is preserved -->
        <Frame x:Name="PageFrame" Grid.ColumnSpan="2" Panel.ZIndex="20"
               Visibility="Collapsed" NavigationUIVisibility="Hidden"
               Background="#0D121B"/>
    </Grid>
</Window>
