<Page x:Class="BulkCarnageForever.V10.Desktop.MealTrackerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="#0D121B" Foreground="#F0F5FA"
      FontFamily="Segoe UI" Loaded="Window_Loaded"
      UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Page.Resources>
        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#96A8BC"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <Style x:Key="MealPanel" TargetType="Border">
            <Setter Property="Background" Value="#1A2736"/>
            <Setter Property="BorderBrush" Value="#314154"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="17"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="MinHeight" Value="190"/>
        </Style>
        <Style x:Key="MealListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="FoodResultItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="Transparent"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2A3C4F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#294436"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MealRowTemplate">
            <Border BorderBrush="#2C3D50" BorderThickness="0,0,0,1"
                    Padding="0,11,0,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{Binding FoodName}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#F4F8FC"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Details}" FontSize="11"
                                   Foreground="#9AACBF" Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Remove"
                               Tag="{Binding Id}" Click="Remove_Click"
                               Appearance="Danger" FontSize="11"
                               VerticalAlignment="Center" Padding="9,5"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="FoodSearchTemplate">
            <StackPanel Margin="3,6">
                <TextBlock Text="{Binding RecipeName}" Foreground="#F4F8FC"
                           FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding BrandType}" Foreground="#A5B5C7"
                               FontSize="11"/>
                    <TextBlock Text="  ·  " Foreground="#72879E" FontSize="11"/>
                    <TextBlock Text="{Binding GroupName}" Foreground="#A5B5C7"
                               FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="30,22,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,23">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ui:Button Content="←  Food Library" Appearance="Secondary"
                           FontSize="12" Padding="10,6" Click="Back_Click"
                           HorizontalAlignment="Left" Margin="0,0,0,13"/>
                <TextBlock Text="Daily Nutrition" Foreground="#F6FAFF"
                           FontSize="31" FontWeight="Bold"/>
                <TextBlock Text="Log what you ate. Watch your progress. Own your day."
                           Foreground="#91A4BA" FontSize="13" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                <TextBlock Text="TRACKING DATE" Style="{StaticResource Kicker}"/>
                <DatePicker x:Name="DayPicker" Width="186" Height="42"
                            SelectedDateFormat="Short"
                            Background="#202F40" Foreground="#F4F8FC"
                            BorderBrush="#43566A"
                            SelectedDateChanged="DayPicker_SelectedDateChanged"/>
            </StackPanel>
        </Grid>

        <!-- Macro total strips -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,22">
            <Border Margin="6" Background="#1D2C3E" BorderBrush="#35485B"
                    BorderThickness="1" CornerRadius="13" Padding="17,15">
                <StackPanel>
                    <TextBlock Text="CALORIES" Foreground="#94A7BC" FontSize="11"/>
                    <TextBlock x:Name="CaloriesTotal" Text="0" Foreground="#BDF473"
                               FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/>
                    <Border Height="3" Background="#BDF473" CornerRadius="2"
                            Width="44" HorizontalAlignment="Left" Margin="0,11,0,0"/>
                </StackPanel>
            </Border>
            <Border Margin="6" Background="#1D2C3E" BorderBrush="#35485B"
                    BorderThickness="1" CornerRadius="13" Padding="17,15">
                <StackPanel>
                    <TextBlock Text="PROTEIN" Foreground="#94A7BC" FontSize="11"/>
                    <TextBlock x:Name="ProteinTotal" Text="0g" Foreground="#F4F8FC"
                               FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/>
                    <Border Height="3" Background="#72D6BD" CornerRadius="2"
                            Width="44" HorizontalAlignment="Left" Margin="0,11,0,0"/>
                </StackPanel>
            </Border>
            <Border Margin="6" Background="#1D2C3E" BorderBrush="#35485B"
                    BorderThickness="1" CornerRadius="13" Padding="17,15">
                <StackPanel>
                    <TextBlock Text="CARBS" Foreground="#94A7BC" FontSize="11"/>
                    <TextBlock x:Name="CarbsTotal" Text="0g" Foreground="#F4F8FC"
                               FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/>
                    <Border Height="3" Background="#F4C078" CornerRadius="2"
                            Width="44" HorizontalAlignment="Left" Margin="0,11,0,0"/>
                </StackPanel>
            </Border>
            <Border Margin="6" Background="#1D2C3E" BorderBrush="#35485B"
                    BorderThickness="1" CornerRadius="13" Padding="17,15">
                <StackPanel>
                    <TextBlock Text="FATS" Foreground="#94A7BC" FontSize="11"/>
                    <TextBlock x:Name="FatsTotal" Text="0g" Foreground="#F4F8FC"
                               FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/>
                    <Border Height="3" Background="#B9A5FA" CornerRadius="2"
                            Width="44" HorizontalAlignment="Left" Margin="0,11,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Meals 2×2; compact entry form on right -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="422"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,6,0">
                <StackPanel>
                    <Grid Margin="0,0,12,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="YOUR MEALS" FontWeight="Bold" FontSize="12"
                                   Foreground="#BDF473" VerticalAlignment="Center"/>
                        <TextBlock Text="4 meal windows" Grid.Column="1"
                                   Foreground="#8FA3B8" FontSize="12"/>
                    </Grid>
                    <UniformGrid Columns="2" Rows="2">
                        <Border Style="{StaticResource MealPanel}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                    <TextBlock Text="☀  Breakfast" FontSize="17" FontWeight="SemiBold"
                                               Foreground="#F7FAFD"/>
                                    <TextBlock x:Name="BreakfastSummary" Text="0 foods"
                                               DockPanel.Dock="Right" Foreground="#BDF473"
                                               FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="BreakfastItems" ItemTemplate="{StaticResource MealRowTemplate}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MealPanel}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                    <TextBlock Text="◉  Lunch" FontSize="17" FontWeight="SemiBold"
                                               Foreground="#F7FAFD"/>
                                    <TextBlock x:Name="LunchSummary" Text="0 foods"
                                               DockPanel.Dock="Right" Foreground="#BDF473"
                                               FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="LunchItems" ItemTemplate="{StaticResource MealRowTemplate}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MealPanel}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                    <TextBlock Text="☾  Dinner" FontSize="17" FontWeight="SemiBold"
                                               Foreground="#F7FAFD"/>
                                    <TextBlock x:Name="DinnerSummary" Text="0 foods"
                                               DockPanel.Dock="Right" Foreground="#BDF473"
                                               FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="DinnerItems" ItemTemplate="{StaticResource MealRowTemplate}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MealPanel}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                    <TextBlock Text="✦  Snack" FontSize="17" FontWeight="SemiBold"
                                               Foreground="#F7FAFD"/>
                                    <TextBlock x:Name="SnackSummary" Text="0 foods"
                                               DockPanel.Dock="Right" Foreground="#BDF473"
                                               FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="SnackItems" ItemTemplate="{StaticResource MealRowTemplate}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- Entry panel -->
            <Border Grid.Column="1" Background="#192737" BorderBrush="#344659"
                    BorderThickness="1" CornerRadius="14" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ADD TO YOUR DAY" FontSize="11" FontWeight="Bold"
                                   Foreground="#BDF473" Margin="0,0,0,7"/>
                        <TextBlock Text="Log a food" FontSize="23" FontWeight="SemiBold"
                                   Foreground="#F4F8FC"/>
                        <TextBlock Text="Choose a food and enter how much you ate."
                                   Foreground="#92A6BB" FontSize="12" Margin="0,6,0,21"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="FIND A FOOD" Style="{StaticResource Kicker}"/>
                        <TextBox x:Name="FoodSearchBox" Height="43"
                                    ToolTip="Search your catalog" FontSize="13"
                                    TextChanged="FoodSearchBox_TextChanged"/>
                        <ListBox x:Name="FoodResults" Height="165" Margin="0,10,0,16"
                                 Background="#101B28" BorderBrush="#334659"
                                 BorderThickness="1" ItemTemplate="{StaticResource FoodSearchTemplate}"
                                 ItemContainerStyle="{StaticResource FoodResultItem}"
                                 SelectionChanged="FoodResults_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                        <Border Background="#22364A" CornerRadius="10" Padding="12"
                                Margin="0,0,0,17">
                            <StackPanel>
                                <TextBlock x:Name="SelectedFoodText" Text="Choose a food above"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#BDF473" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ServingText" Text=""
                                           Foreground="#B5C5D5" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="MEAL" Style="{StaticResource Kicker}"/>
                        <ComboBox x:Name="MealTypeBox" Height="42"
                                     HorizontalAlignment="Stretch" FontSize="13"
                                     Margin="0,0,0,18"/>

                        <TextBlock Text="AMOUNT EATEN" Style="{StaticResource Kicker}"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AmountBox" Grid.Column="0" Height="43"
                                        FontSize="14" ToolTip="Enter quantity"
                                        TextChanged="AmountBox_TextChanged"/>
                            <TextBlock x:Name="UnitText" Grid.Column="1" Text="units"
                                       Foreground="#CDD9E5" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <Border Background="#142532" BorderBrush="#2B4A47"
                                BorderThickness="1" CornerRadius="10" Padding="13"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="NUTRITION PREVIEW" FontSize="10"
                                           FontWeight="Bold" Foreground="#91C8B9"
                                           Margin="0,0,0,7"/>
                                <TextBlock x:Name="PreviewText"
                                           Text="Choose a food to preview its nutrition."
                                           Foreground="#D7E4EF" FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ui:Button x:Name="AddButton" Content="+  Add to Meal"
                                   Appearance="Primary" Height="43"
                                   HorizontalAlignment="Stretch"
                                   FontSize="14" FontWeight="SemiBold"
                                   Click="Add_Click" IsEnabled="False"/>
                        <TextBlock x:Name="StatusText" Foreground="#BDF473"
                                   TextWrapping="Wrap" FontSize="12"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
