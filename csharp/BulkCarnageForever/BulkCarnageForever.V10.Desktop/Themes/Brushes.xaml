<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <SolidColorBrush x:Key="Lime" Color="{DynamicResource Theme.accent}"/>
 <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource Theme.accent}"/>
 <SolidColorBrush x:Key="AppBackground" Color="{DynamicResource Theme.bg}"/>
 <SolidColorBrush x:Key="SidebarBackground" Color="{DynamicResource Theme.side}"/>
 <SolidColorBrush x:Key="SurfaceBackground" Color="{DynamicResource Theme.surface}"/>
 <SolidColorBrush x:Key="SurfaceRaised" Color="{DynamicResource Theme.raised}"/>
 <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource Theme.line}"/>
 <SolidColorBrush x:Key="InputBackground" Color="{DynamicResource Theme.input}"/>
 <SolidColorBrush x:Key="ControlBackground" Color="{DynamicResource Theme.control}"/>
 <SolidColorBrush x:Key="HoverBackground" Color="{DynamicResource Theme.hover}"/>
 <SolidColorBrush x:Key="TrackBackground" Color="{DynamicResource Theme.line}"/>
 <SolidColorBrush x:Key="AccentSurface" Color="{DynamicResource Theme.soft}"/>
 <SolidColorBrush x:Key="AccentBorder" Color="{DynamicResource Theme.border}"/>
 <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{DynamicResource Theme.accent}"/>
 <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{DynamicResource Theme.accent}"/>
 <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{DynamicResource Theme.border}"/>
 <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource Theme.input}"/>
 <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource Theme.surface}"/>
 <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource Theme.line}"/>
 <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{DynamicResource Theme.accent}"/>
 <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{DynamicResource Theme.soft}"/>
 <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{DynamicResource Theme.accent}"/>
 <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{DynamicResource Theme.accent}"/>
 <SolidColorBrush x:Key="PrimaryText" Color="#F5F7FB"/>
 <SolidColorBrush x:Key="SecondaryText" Color="#B7C2D0"/>
 <SolidColorBrush x:Key="Muted" Color="#B7C2D0"/>
 <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F5F7FB"/>
 <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B7C2D0"/>
 <SolidColorBrush x:Key="ComboBoxForeground" Color="#F5F7FB"/>
 <SolidColorBrush x:Key="Teal" Color="#FF73A3"/>
 <SolidColorBrush x:Key="Amber" Color="#55D5F5"/>
 <SolidColorBrush x:Key="Violet" Color="#F6CF63"/>
 <SolidColorBrush x:Key="FiberBrush" Color="#83DEAF"/>
 <SolidColorBrush x:Key="SuccessBrush" Color="#83DEAF"/>
 <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{DynamicResource Theme.raised}" Offset="0"/><GradientStop Color="{DynamicResource Theme.surface}" Offset="1"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{DynamicResource Theme.control}" Offset="0"/><GradientStop Color="{DynamicResource Theme.surface}" Offset="1"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="HeroScrim" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F00C1017" Offset="0"/><GradientStop Color="#D90C1017" Offset="0.42"/><GradientStop Color="#550C1017" Offset="1"/></LinearGradientBrush>
 <SolidColorBrush x:Key="PrimaryAccent" Color="{DynamicResource Theme.primary}"/>
</ResourceDictionary>
